{
  "name": "mythica-mono",
  "private": true,
  "version": "0.0.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:front": "bun run --cwd apps/mythica-front dev",
    "dev:api": "bun run --cwd apps/mythica-api dev",
    "dev:gateway": "bun run --cwd apps/mythica-gateway dev",
    "dev:gameplay": "bun run --cwd apps/mythica-gameplay dev",
    "lint": "biome check --write ./apps/mythica-api ./apps/mythica-gateway ./apps/mythica-gameplay",
    "lint:ci": "biome ci ./apps/mythica-api ./apps/mythica-gateway ./apps/mythica-gameplay"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0"
  }
}
