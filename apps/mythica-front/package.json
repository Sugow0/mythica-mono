{
	"name": "mythica-front",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . --fix --format pretty",
		"lint:ci": "eslint . --format pretty",
		"format": "prettier --write .",
		"format:ci": "prettier --check .",
		"test": "vitest run",
		"generate:types": "bun run generate:types:platform && bun run generate:types:gameplay",
		"generate:types:platform": "openapi-typescript ${PUBLIC_API_URL:-http://localhost:2100}/api/swagger/json -o ./src/lib/api/generated/platform.ts",
		"generate:types:gameplay": "openapi-typescript ${PUBLIC_API_URL:-http://localhost:2100}/gameplay/swagger/json -o ./src/lib/api/generated/gameplay.ts",
		"knip": "knip"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.2.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^25.6.0",
		"@vitest/browser-playwright": "^4.0.18",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-formatter-pretty": "^7.0.0",
		"eslint-plugin-svelte": "^3.17.0",
		"knip": "^6.3.1",
		"layerchart": "2.0.0-next.43",
		"mode-watcher": "^1.1.0",
		"openapi-typescript": "^7.13.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.59.1",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"svelte-eslint-parser": "^1.6.0",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "^1.61.0",
		"@inlang/paraglide-js": "^2.12.0",
		"@threlte/core": "^8.5.5",
		"lucide": "^0.575.0",
		"openapi-fetch": "^0.17.0"
	}
}
