// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum PropertyType {
  text
  number
  boolean
  select
  multiselect
  textarea
  resource
  list
  derived

  @@map("property_type")
}

enum CampaignStatus {
  active
  paused
  archived

  @@map("campaign_status")
}

enum CharacterSheetVisibility {
  private
  campaign
  public

  @@map("character_sheet_visibility")
}

enum MemberRole {
  gm
  player
  spectator

  @@map("member_role")
}

enum SessionStatus {
  scheduled
  active
  paused
  ended

  @@map("session_status")
}

enum TokenLayer {
  background
  object
  token
  gm

  @@map("token_layer")
}

enum FileDomain {
  map
  token
  music
  notes
  report
  video
  asset
  avatar
  cover

  @@map("file_domain")
}

enum GridType {
  square
  hex
  free

  @@map("grid_type")
}

enum JoinRequestStatus {
  pending
  accepted
  declined

  @@map("join_request_status")
}

enum ContentImportJobStatus {
  scanning
  ready
  applying
  applied
  failed

  @@map("content_import_job_status")
}

enum ContentImportItemStatus {
  pending
  approved
  rejected

  @@map("content_import_item_status")
}

enum CampaignSheetStatus {
  active
  inactive
  disabled

  @@map("campaign_sheet_status")
}

enum CampaignPoolRequestStatus {
  pending
  confirmed
  rejected

  @@map("campaign_pool_request_status")
}

enum CampaignChangeRequestStatus {
  pending
  approved
  rejected

  @@map("campaign_change_request_status")
}

// Types d'étapes génériques du parcours de création (alignés sur character-engine).
enum CreationStepKind {
  selection
  repeatableSelection
  pointAllocation
  hitPoints
  abilityImprovement
  proficiencyChoice
  spellSelection
  inventory
  loreForm

  @@map("creation_step_kind")
}

// ------------------------------------------------------------
// USER
// Miroir léger de l'API plateforme.
// Stocke uniquement l'UUID de référence.
// ------------------------------------------------------------

model User {
  id        String   @id @db.Uuid
  pseudo    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  ownedCampaigns  Campaign[]            @relation("CampaignOwner")
  campaignMembers CampaignMember[]
  characterSheets CharacterSheet[]
  files           File[]
  messages        Message[]
  joinRequests    CampaignJoinRequest[]

  @@map("users")
}

// ------------------------------------------------------------
// GAME SYSTEM
// Exemples : D&D 5e (2014), CoC 7e, PF2e...
// parent permet le fork/héritage de système.
// ------------------------------------------------------------

model GameSystem {
  id             String   @id @db.Uuid
  nom            String   @db.VarChar(255)
  version        String   @db.VarChar(50)
  slug           String   @unique @db.VarChar(100)
  parentSystemId String?  @map("parent_system_id") @db.Uuid
  isOfficial     Boolean  @default(false) @map("is_official")
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Auto-référence (fork/héritage)
  parent   GameSystem?  @relation("GameSystemFork", fields: [parentSystemId], references: [id], onDelete: SetNull)
  children GameSystem[] @relation("GameSystemFork")

  // Relations
  properties      GameSystemProperty[]
  campaigns       Campaign[]
  characterSheets CharacterSheet[]
  content         SystemContent[]
  creationSteps   GameSystemCreationStep[]
  importJobs      ContentImportJob[]

  @@map("game_systems")
}

// ------------------------------------------------------------
// CHARACTER SHEET PROPERTY (définition d'un champ)
// Champ réutilisable entre systèmes.
// ------------------------------------------------------------

model CharacterSheetProperty {
  id           String       @id @db.Uuid
  key          String       @unique @db.VarChar(100)
  label        String       @db.VarChar(255)
  type         PropertyType
  defaultValue String?      @map("default_value") @db.Text
  minValue     Decimal?     @map("min_value") @db.Decimal
  maxValue     Decimal?     @map("max_value") @db.Decimal
  options      Json?
  description  String?      @db.Text
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  gameSystems    GameSystemProperty[]
  sheetValues    CharacterSheetValue[]
  tokenOverrides SessionTokenOverride[]

  @@index([key], name: "idx_properties_key")
  @@map("character_sheet_properties")
}

// ------------------------------------------------------------
// GAME SYSTEM ↔ PROPERTIES
// Assemble les propriétés d'un système.
// overrideLabel / overrideDefault permettent d'adapter
// une propriété existante sans la recréer.
// ------------------------------------------------------------

model GameSystemProperty {
  id              String   @id @db.Uuid
  gameSystemId    String   @map("game_system_id") @db.Uuid
  propertyId      String   @map("property_id") @db.Uuid
  displayOrder    Int      @default(0) @map("display_order")
  groupName       String?  @map("group_name") @db.VarChar(100)
  isRequired      Boolean  @default(false) @map("is_required")
  overrideLabel   String?  @map("override_label") @db.VarChar(255)
  overrideDefault String?  @map("override_default") @db.Text
  formula         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  gameSystem GameSystem             @relation(fields: [gameSystemId], references: [id], onDelete: Cascade)
  property   CharacterSheetProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([gameSystemId, propertyId])
  @@map("game_system_properties")
}

// ------------------------------------------------------------
// CAMPAIGN
// ------------------------------------------------------------

model Campaign {
  id           String         @id @db.Uuid
  ownerId      String         @map("owner_id") @db.Uuid
  gameSystemId String         @map("game_system_id") @db.Uuid
  nom          String         @db.VarChar(255)
  description  String?        @db.Text
  isPublic     Boolean        @default(false)
  status       CampaignStatus @default(active)
  tags         String[]       @default([])
  coverFileId             String?        @map("cover_file_id") @db.Uuid
  characterCreationLocked Boolean        @default(false) @map("character_creation_locked")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime?      @map("deleted_at") @db.Timestamptz

  // Relations
  owner           User                              @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  gameSystem      GameSystem                        @relation(fields: [gameSystemId], references: [id], onDelete: Restrict)
  coverFile       File?                             @relation("CampaignCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  members         CampaignMember[]
  characterSheets CampaignCharacterSheet[]
  poolSheets      CampaignPoolSheet[]
  changeRequests  CampaignCharacterChangeRequest[]
  sessions        Session[]
  files           File[]                            @relation("CampaignFiles")
  maps            Map[]
  invites         CampaignInvite[]
  messages        Message[]
  joinRequests    CampaignJoinRequest[]

  @@index([deletedAt], name: "idx_campaigns_deleted")
  @@map("campaigns")
}

// ------------------------------------------------------------
// CAMPAIGN MESSAGES
// Messages du chat de campagne (diffusés en temps réel via Redis pub/sub).
// ------------------------------------------------------------

model Message {
  id         String   @id @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  content    String   @db.Text
  sessionId  String?  @map("session_id") @db.Uuid
  kind       String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session  Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt], name: "idx_messages_campaign_created")
  @@index([sessionId], name: "idx_messages_session")
  @@map("campaign_messages")
}

// ------------------------------------------------------------
// CAMPAIGN INVITES
// Lien d'invitation à usage partagé, identifié par un token unique
// et expirant après un délai (7 jours par défaut).
// ------------------------------------------------------------

model CampaignInvite {
  id         String   @id @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  token      String   @unique @db.VarChar(64)
  createdBy  String   @map("created_by") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId], name: "idx_campaign_invites_campaign")
  @@map("campaign_invites")
}

// ------------------------------------------------------------
// CAMPAIGN JOIN REQUESTS
// Demande d'acces a une campagne publique, approuvee par le MJ.
// ------------------------------------------------------------

model CampaignJoinRequest {
  id         String            @id @db.Uuid
  campaignId String            @map("campaign_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  status     JoinRequestStatus @default(pending)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId, status], name: "idx_join_requests_campaign_status")
  @@map("campaign_join_requests")
}

// ------------------------------------------------------------
// CAMPAIGN MEMBERS
// ------------------------------------------------------------

model CampaignMember {
  id         String     @id @db.Uuid
  campaignId String     @map("campaign_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  role       MemberRole @default(player)
  joinedAt   DateTime   @default(now()) @map("joined_at") @db.Timestamptz
  leftAt     DateTime?  @map("left_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId], name: "idx_campaign_members_campaign")
  @@index([userId], name: "idx_campaign_members_user")
  @@map("campaign_members")
}

// ------------------------------------------------------------
// CHARACTER SHEET
// ------------------------------------------------------------

model CharacterSheet {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  gameSystemId  String    @map("game_system_id") @db.Uuid
  name          String    @db.VarChar(255)
  avatarFileId  String?   @map("avatar_file_id") @db.Uuid
  isActive      Boolean   @default(true) @map("is_active")
  // Résultat du build : monnaie de départ et méthode de génération des caracs.
  gold          Int?
  abilityMethod String?   @map("ability_method") @db.VarChar(30)
  // Visibilité de la fiche : privée (défaut), partagée campagne, ou publique.
  visibility    CharacterSheetVisibility @default(private)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameSystem GameSystem                @relation(fields: [gameSystemId], references: [id], onDelete: Restrict)
  avatarFile File?                     @relation("CharacterSheetAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  values     CharacterSheetValue[]
  selections CharacterSheetSelection[]
  campaigns  CampaignCharacterSheet[]
  tokens     SessionToken[]
  poolSheet            CampaignPoolSheet?   @relation("PoolSheetCharacter")
  poolRequestAssignment CampaignPoolRequest? @relation("PoolRequestAssignment")

  @@index([userId], name: "idx_character_sheets_user")
  @@index([gameSystemId], name: "idx_character_sheets_system")
  @@map("character_sheets")
}

// ------------------------------------------------------------
// CHARACTER SHEET VALUES
// Valeurs réelles des propriétés d'une fiche.
// number   → {"v": 12}
// resource → {"current": 8, "max": 45}
// list     → {"items": [...]}
// ------------------------------------------------------------

model CharacterSheetValue {
  id               String   @id @db.Uuid
  characterSheetId String   @map("character_sheet_id") @db.Uuid
  propertyId       String   @map("property_id") @db.Uuid
  value            Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  characterSheet CharacterSheet         @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)
  property       CharacterSheetProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([characterSheetId, propertyId])
  @@index([characterSheetId], name: "idx_sheet_values_sheet")
  @@map("character_sheet_values")
}

// ------------------------------------------------------------
// CAMPAIGN ↔ CHARACTER SHEETS
// ------------------------------------------------------------

model CampaignCharacterSheet {
  id               String              @id @db.Uuid
  campaignId       String              @map("campaign_id") @db.Uuid
  characterSheetId String              @map("character_sheet_id") @db.Uuid
  status           CampaignSheetStatus @default(inactive)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  campaign       Campaign                         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterSheet CharacterSheet                   @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)
  changeRequests CampaignCharacterChangeRequest[]

  @@unique([campaignId, characterSheetId])
  @@index([campaignId, status], name: "idx_campaign_sheets_status")
  @@map("campaign_character_sheets")
}

// ------------------------------------------------------------
// CAMPAIGN POOL SHEETS
// Fiches pré-construites par le MJ, proposées aux joueurs.
// Chaque entrée pointe vers un snapshot CharacterSheet appartenant au MJ.
// ------------------------------------------------------------

model CampaignPoolSheet {
  id               String   @id @db.Uuid
  campaignId       String   @map("campaign_id") @db.Uuid
  characterSheetId String   @unique @map("character_sheet_id") @db.Uuid
  visibleToPlayers Boolean  @default(false) @map("visible_to_players")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  campaign       Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterSheet CharacterSheet        @relation("PoolSheetCharacter", fields: [characterSheetId], references: [id], onDelete: Cascade)
  requests       CampaignPoolRequest[]

  @@index([campaignId], name: "idx_pool_sheets_campaign")
  @@map("campaign_pool_sheets")
}

// ------------------------------------------------------------
// CAMPAIGN POOL REQUESTS
// Demande d'un joueur pour obtenir une fiche du pool MJ.
// ------------------------------------------------------------

model CampaignPoolRequest {
  id                String                    @id @db.Uuid
  poolSheetId       String                    @map("pool_sheet_id") @db.Uuid
  requestedByUserId String                    @map("requested_by_user_id") @db.Uuid
  status            CampaignPoolRequestStatus @default(pending)
  assignedSheetId   String?                   @unique @map("assigned_sheet_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  poolSheet     CampaignPoolSheet @relation(fields: [poolSheetId], references: [id], onDelete: Cascade)
  assignedSheet CharacterSheet?   @relation("PoolRequestAssignment", fields: [assignedSheetId], references: [id], onDelete: SetNull)

  @@unique([poolSheetId, requestedByUserId])
  @@index([poolSheetId, status], name: "idx_pool_requests_status")
  @@map("campaign_pool_requests")
}

// ------------------------------------------------------------
// CAMPAIGN CHARACTER CHANGE REQUESTS
// Demande d'un joueur pour changer de personnage actif.
// Requiert validation du MJ ; ancienne fiche → disabled à l'approbation.
// ------------------------------------------------------------

model CampaignCharacterChangeRequest {
  id            String                      @id @db.Uuid
  campaignId    String                      @map("campaign_id") @db.Uuid
  playerId      String                      @map("player_id") @db.Uuid
  targetSheetId String                      @map("target_sheet_id") @db.Uuid
  status        CampaignChangeRequestStatus @default(pending)
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  campaign    Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetSheet CampaignCharacterSheet @relation(fields: [targetSheetId], references: [id], onDelete: Restrict)

  @@unique([campaignId, playerId, targetSheetId])
  @@index([campaignId, status], name: "idx_change_requests_campaign_status")
  @@map("campaign_character_change_requests")
}

// ------------------------------------------------------------
// SESSION
// map_state et combat_state : snapshots JSONB temps réel.
// ------------------------------------------------------------

model Session {
  id          String        @id @db.Uuid
  campaignId  String        @map("campaign_id") @db.Uuid
  nom         String        @db.VarChar(255)
  status      SessionStatus @default(scheduled)
  scheduledAt DateTime?     @map("scheduled_at") @db.Timestamptz
  startedAt   DateTime?     @map("started_at") @db.Timestamptz
  endedAt     DateTime?     @map("ended_at") @db.Timestamptz
  mapState    Json          @default("{}") @map("map_state")
  combatState Json          @default("{}") @map("combat_state")
  activeMapId String?       @map("active_map_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  campaign        Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  activeMap       Map?           @relation("SessionActiveMap", fields: [activeMapId], references: [id], onDelete: SetNull)
  tokens          SessionToken[]
  sessionMessages Message[]

  @@index([campaignId], name: "idx_sessions_campaign")
  @@index([status], name: "idx_sessions_status")
  @@map("sessions")
}

// ------------------------------------------------------------
// SESSION TOKEN
// Données visuelles/positionnelles uniquement.
// Stats et conditions → SessionTokenOverride.
// ------------------------------------------------------------

model SessionToken {
  id               String     @id @db.Uuid
  sessionId        String     @map("session_id") @db.Uuid
  characterSheetId String?    @map("character_sheet_id") @db.Uuid
  label            String?    @db.VarChar(255)
  fileId           String?    @map("file_id") @db.Uuid
  posX             Decimal    @default(0) @map("pos_x") @db.Decimal
  posY             Decimal    @default(0) @map("pos_y") @db.Decimal
  width            Int        @default(1)
  height           Int        @default(1)
  isVisible        Boolean    @default(true) @map("is_visible")
  layer            TokenLayer @default(token)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  session        Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  characterSheet CharacterSheet?        @relation(fields: [characterSheetId], references: [id], onDelete: SetNull)
  file           File?                  @relation("TokenFile", fields: [fileId], references: [id], onDelete: SetNull)
  overrides      SessionTokenOverride[]

  @@index([sessionId], name: "idx_session_tokens_session")
  @@map("session_tokens")
}

// ------------------------------------------------------------
// SESSION TOKEN OVERRIDE
// État temporaire des propriétés en session.
// Même format JSONB que CharacterSheetValue.
// ------------------------------------------------------------

model SessionTokenOverride {
  id             String   @id @db.Uuid
  sessionTokenId String   @map("session_token_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  value          Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  sessionToken SessionToken           @relation(fields: [sessionTokenId], references: [id], onDelete: Cascade)
  property     CharacterSheetProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([sessionTokenId, propertyId])
  @@index([sessionTokenId], name: "idx_token_overrides_token")
  @@index([propertyId], name: "idx_token_overrides_property")
  @@map("session_token_overrides")
}

// ------------------------------------------------------------
// FILE
// Métadonnées légères pour RustFS.
// URL reconstruite côté code, jamais stockée en DB.
// ------------------------------------------------------------

model File {
  id          String     @id @db.Uuid
  ownerId     String     @map("owner_id") @db.Uuid
  campaignId  String?    @map("campaign_id") @db.Uuid
  domain      FileDomain
  displayName String     @map("display_name") @db.VarChar(255)
  mimeType    String     @map("mime_type") @db.VarChar(100)
  sizeBytes   BigInt?    @map("size_bytes")
  isPublic    Boolean    @default(false) @map("is_public")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz

  // Relations
  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation("CampaignFiles", fields: [campaignId], references: [id], onDelete: Cascade)

  // Relations inverses (utilisé comme référence depuis d'autres tables)
  campaignCovers   Campaign[]       @relation("CampaignCover")
  characterAvatars CharacterSheet[] @relation("CharacterSheetAvatar")
  sessionTokens    SessionToken[]   @relation("TokenFile")
  contentPortraits SystemContent[]  @relation("SystemContentPortrait")
  maps             Map[]            @relation("MapFile")

  @@index([ownerId], name: "idx_files_owner")
  @@index([campaignId, domain], name: "idx_files_campaign_domain")
  @@index([deletedAt], name: "idx_files_deleted")
  @@map("files")
}

// ------------------------------------------------------------
// MAP
// Carte utilisée dans une session. L'image de fond est un File
// (domain: map). La grille est configurable par type et taille.
// ------------------------------------------------------------

model Map {
  id          String   @id @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  nom         String   @db.VarChar(255)
  fileId      String?  @map("file_id") @db.Uuid
  gridType    GridType @default(square) @map("grid_type")
  gridSize    Int      @default(100) @map("grid_size")
  gridOffsetX Int      @default(0) @map("grid_offset_x")
  gridOffsetY Int      @default(0) @map("grid_offset_y")
  gridColor   String   @default("#ffffff33") @map("grid_color") @db.VarChar(9)
  gridOpacity Decimal  @default(0.3) @map("grid_opacity") @db.Decimal
  widthPx     Int      @default(2000) @map("width_px")
  heightPx    Int      @default(2000) @map("height_px")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  file     File?     @relation("MapFile", fields: [fileId], references: [id], onDelete: SetNull)
  sessions Session[] @relation("SessionActiveMap")

  @@index([campaignId], name: "idx_maps_campaign")
  @@map("maps")
}

// ------------------------------------------------------------
// SYSTEM CONTENT
// Contenu d'un système, regroupé par collection générique
// (collectionKey : "race", "classe", "background", "sort", "type"...).
// `data` (JSONB) porte les champs propres à la collection ; il est validé à
// l'écriture (seed) contre un schéma par collection — jamais saisi par
// l'utilisateur. Ajouter une collection ne demande aucune migration.
// ------------------------------------------------------------

model SystemContent {
  id             String   @id @db.Uuid
  gameSystemId   String   @map("game_system_id") @db.Uuid
  collectionKey  String   @map("collection_key") @db.VarChar(50)
  slug           String   @db.VarChar(100)
  name           String   @db.VarChar(255)
  description    String?  @db.Text
  data           Json     @default("{}")
  sortOrder      Int      @default(0) @map("sort_order")
  portraitFileId String?  @map("portrait_file_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  gameSystem   GameSystem                @relation(fields: [gameSystemId], references: [id], onDelete: Cascade)
  portraitFile File?                     @relation("SystemContentPortrait", fields: [portraitFileId], references: [id], onDelete: SetNull)
  selections   CharacterSheetSelection[]

  @@unique([gameSystemId, collectionKey, slug])
  @@index([gameSystemId, collectionKey], name: "idx_system_content_collection")
  @@map("system_content")
}

// ------------------------------------------------------------
// GAME SYSTEM CREATION STEP
// Parcours de création data-driven : étapes ordonnées + config (JSONB) propre
// au `kind`. Le front est un rendu générique piloté par ces données.
// ------------------------------------------------------------

model GameSystemCreationStep {
  id           String           @id @db.Uuid
  gameSystemId String           @map("game_system_id") @db.Uuid
  stepKey      String           @map("step_key") @db.VarChar(100)
  order        Int              @map("step_order")
  kind         CreationStepKind
  config       Json             @default("{}")
  condition    String?          @db.VarChar(100)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  gameSystem GameSystem @relation(fields: [gameSystemId], references: [id], onDelete: Cascade)

  @@unique([gameSystemId, stepKey])
  @@index([gameSystemId, order], name: "idx_creation_steps_order")
  @@map("game_system_creation_steps")
}

// ------------------------------------------------------------
// CHARACTER SHEET SELECTION
// Résultat « build » d'une fiche : éléments de contenu choisis. Références et
// scalaires stables = colonnes typées (intégrité forte) ; `extra` (JSONB) ne
// porte que l'accessoire variable. Gère le multiclassage (plusieurs lignes
// collectionKey="classe" avec `level`/`isPrimary`) et les sous-sélections
// (sous-classe via `parentSelectionId`).
// ------------------------------------------------------------

model CharacterSheetSelection {
  id                String   @id @db.Uuid
  characterSheetId  String   @map("character_sheet_id") @db.Uuid
  collectionKey     String   @map("collection_key") @db.VarChar(50)
  contentId         String   @map("content_id") @db.Uuid
  level             Int?
  isPrimary         Boolean? @map("is_primary")
  parentSelectionId String?  @map("parent_selection_id") @db.Uuid
  qty               Int?
  extra             Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations — contentId en Restrict : impossible de pointer un contenu supprimé.
  characterSheet  CharacterSheet            @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)
  content         SystemContent             @relation(fields: [contentId], references: [id], onDelete: Restrict)
  parentSelection CharacterSheetSelection?  @relation("SelectionParent", fields: [parentSelectionId], references: [id], onDelete: Cascade)
  childSelections CharacterSheetSelection[] @relation("SelectionParent")

  @@index([characterSheetId], name: "idx_sheet_selections_sheet")
  @@index([characterSheetId, collectionKey], name: "idx_sheet_selections_collection")
  @@map("character_sheet_selections")
}

// ------------------------------------------------------------
// CONTENT IMPORT
// Workflow de révision : scan aidedd → staging → approbation → prod.
// ------------------------------------------------------------

model ContentImportJob {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameSystemId  String                 @map("game_system_id") @db.Uuid
  collection    String                 @db.VarChar(50)
  status        ContentImportJobStatus @default(scanning)
  totalFound    Int                    @default(0) @map("total_found")
  totalFetched  Int                    @default(0) @map("total_fetched")
  totalNew      Int                    @default(0) @map("total_new")
  totalUpdated  Int                    @default(0) @map("total_updated")
  errorMessage  String?                @map("error_message") @db.Text
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz
  completedAt   DateTime?              @map("completed_at") @db.Timestamptz
  appliedAt     DateTime?              @map("applied_at") @db.Timestamptz

  gameSystem GameSystem          @relation(fields: [gameSystemId], references: [id], onDelete: Cascade)
  items      ContentImportItem[]

  @@index([gameSystemId], name: "idx_import_jobs_game_system")
  @@map("content_import_jobs")
}

model ContentImportItem {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String                  @map("job_id") @db.Uuid
  slug          String                  @db.VarChar(150)
  name          String?                 @db.VarChar(255)
  description   String?                 @db.Text
  isNew         Boolean                 @default(true) @map("is_new")
  existingId    String?                 @map("existing_id") @db.Uuid
  status        ContentImportItemStatus @default(pending)
  reviewedAt    DateTime?               @map("reviewed_at") @db.Timestamptz

  job ContentImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, slug])
  @@index([jobId, status], name: "idx_import_items_job_status")
  @@map("content_import_items")
}
