// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleEnum {
  ADMIN
  SUPPORT
  USER
}

model Users {
  id                      String                    @id @default(uuid(7)) @db.Uuid
  firstName               String
  lastName                String
  pseudo                  String                    @unique
  avatar                  String?
  bio                     String?
  email                   String                    @unique
  password                String? // null pour les comptes OAuth uniquement
  emailVerified           Boolean                   @default(false)
  emailVerifiedAt         DateTime?
  twoFactorSecret         String? // secret TOTP (hex) pour 2FA
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  sessions                Sessions[]
  role                    RoleEnum                  @default(USER)
  oauthAccounts           OAuthAccounts[]
  emailVerificationTokens EmailVerificationTokens[]
  passwordResetTokens     PasswordResetTokens[]

  @@map("users")
}

model EmailVerificationTokens {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

model PasswordResetTokens {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model OAuthAccounts {
  id             String @id // id de type Lucia (entropie base32), pas un UUID
  providerId     String // "google" | "discord" | "apple"
  providerUserId String
  userId         String @db.Uuid
  user           Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Sessions {
  id        String   @id // id de session Lucia (entropie), pas un UUID
  userId    String   @db.Uuid
  expiresAt DateTime

  user Users @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("sessions")
}
