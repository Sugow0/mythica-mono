# Exemple de configuration mythica-api — AUCUNE valeur réelle ici.
# En dev, les vraies valeurs vivent dans config/<env>.env, chiffrées via dotenvx.

NODE_ENV=development
PORT=3200
WS_PORT=3250

# Base de données / cache
DATABASE_URL=postgresql://admin:password@localhost:22000/mythica_db
REDIS_URL=redis://localhost:23000

# URLs applicatives
APP_NAME=Mythica
APP_URL=http://localhost:2100
FRONTEND_URL=http://localhost:5173
CORS_URL=["http://localhost:5173"]
OAUTH_FRONT_REDIRECT_URL=http://localhost:5173/auth/callback

# Authentification inter-services
SERVICE_API_KEY=
SESSION_COOKIE_DOMAIN=localhost

# OAuth providers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@mythica.local

# Stockage objet (MinIO / S3)
MINIO_ENDPOINT=localhost:24000
MINIO_USER_ROOT=
MINIO_PASSWORD_ROOT=
MINIO_BUCKET_USERS=users
