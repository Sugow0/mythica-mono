// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id                      String                    @id @default(uuid())
  firstName               String
  lastName                String
  pseudo                  String                    @unique
  avatar                  String?
  email                   String                    @unique
  password                String? // null pour les comptes OAuth uniquement
  emailVerified           Boolean                   @default(false)
  emailVerifiedAt         DateTime?
  twoFactorSecret         String? // secret TOTP (hex) pour 2FA
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  sessions                Sessions[]
  role                    RoleEnum                  @default(USER)
  oauthAccounts           OAuthAccounts[]
  emailVerificationTokens EmailVerificationTokens[]

  campaingsMember     CampaignMembers[]
  campaigns           Campaigns[]
  sessionResponses    CampaignSessionResponses[]
  campaignInvitations CampaignInvitations[]
  characters          Characters[]
}

model EmailVerificationTokens {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model OAuthAccounts {
  id             String @id @default(uuid())
  providerId     String // "google" | "discord" | "apple"
  providerUserId String
  userId         String
  user           Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerUserId])
  @@index([userId])
}

model Sessions {
  id        String   @id
  userId    String
  expiresAt DateTime

  user Users @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model Campaigns {
  id           String                 @id @default(uuid())
  name         String
  description  String?
  status       CampaignStatusEnum     @default(DRAFT)
  visibility   CampaignVisibilityEnum @default(PRIVATE)
  image        String?
  gameSystem   GameSystems            @relation("CampaignGameSystem", fields: [gameSystemId], references: [id], onDelete: Cascade)
  gameSystemId String

  creatorId   String
  creator     Users                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members     CampaignMembers[]
  sessions    CampaignSessions[]
  invitations CampaignInvitations[]
  characters  Characters[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampaignMembers {
  campaignId String
  userId     String
  role       CampaignMemberRoleEnum @default(MEMBER)

  campaign Campaigns @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([campaignId, userId])
}

model CampaignSessions {
  id          String                    @id @default(uuid())
  campaignId  String
  title       String
  description String?
  scheduledAt DateTime
  duration    Int // durée en minutes
  status      CampaignSessionStatusEnum @default(SCHEDULED)

  campaign  Campaigns                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  responses CampaignSessionResponses[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([scheduledAt])
}

model CampaignSessionResponses {
  sessionId String
  userId    String
  status    CampaignSessionResponseStatusEnum @default(PENDING)

  session CampaignSessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    Users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([sessionId, userId])
}

model CampaignInvitations {
  id         String                       @id @default(uuid())
  campaignId String
  userId     String
  invitedBy  String
  status     CampaignInvitationStatusEnum @default(PENDING)

  campaign Campaigns @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, userId])
  @@index([userId])
}

model GameSystems {
  id                 String               @id @default(uuid())
  name               String
  description        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  campaigns          Campaigns[]          @relation("CampaignGameSystem")
  gameSystemVersions GameSystemVersions[] @relation("GameSystemVersions")

  @@index([name])
}

model GameSystemVersions {
  id           String      @id @default(uuid())
  gameSystemId String
  version      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  gameSystem   GameSystems @relation("GameSystemVersions", fields: [gameSystemId], references: [id], onDelete: Cascade)

  @@unique([gameSystemId, version])
  @@index([gameSystemId])
  @@index([version])
}

enum CampaignMemberRoleEnum {
  ADMIN
  MEMBER
}

enum CampaignSessionStatusEnum {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CampaignSessionResponseStatusEnum {
  PENDING
  ACCEPTED
  DECLINED
}

enum CampaignInvitationStatusEnum {
  PENDING
  ACCEPTED
  REFUSED
}

enum CampaignStatusEnum {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CampaignVisibilityEnum {
  PUBLIC
  PRIVATE
}

enum RoleEnum {
  ADMIN
  SUPPORT
  USER
}

enum CharacterTypeEnum {
  PLAYER
  NPC
}

model Characters {
  id       String            @id @default(uuid())
  name     String
  type     CharacterTypeEnum @default(PLAYER)
  data     Json
  isActive Boolean           @default(true)

  campaignId String?
  campaign   Campaigns? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  userId String?
  user   Users?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@index([campaignId, type])
}
